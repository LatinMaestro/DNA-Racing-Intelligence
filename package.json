{
  "name": "dna-racing-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run worker:types && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write lib/race-bounded-materializer.ts tests/race-bounded-materializer.test.ts && git diff -- lib/race-bounded-materializer.ts tests/race-bounded-materializer.test.ts && exit 1",
    "format:write": "prettier --write .",
    "typecheck": "npm run worker:types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:types": "wrangler types worker-configuration.d.ts --include-runtime=false --config wrangler.jsonc",
    "worker:types:check": "wrangler types worker-configuration.d.ts --include-runtime=false --check --config wrangler.jsonc",
    "worker:dry-run": "wrangler deploy --dry-run --strict --experimental-provision=false --experimental-auto-create=false --outdir .wrangler/dry-run --config wrangler.jsonc",
    "validate": "npm run format && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/s3-request-presigner": "3.1106.0",
    "@clerk/nextjs": "7.6.0",
    "@neondatabase/serverless": "1.1.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260821.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
