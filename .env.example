# Preview access switch. Enable only for an intentionally protected Preview.
ENABLE_PHASE0_REVIEW=false

# Explicit Production access switch. Automatic Git deployments remain disabled
# by vercel.json, so routine Git pushes do not deploy this application.
ALLOW_PRODUCTION_DEPLOYMENT=false

# Clerk single-owner authentication. Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AUTHORIZED_CLERK_USER_ID=

# Neon Preview runtime connection and owner binding. DATABASE_URL must authenticate
# directly as DNA_DATABASE_RUNTIME_ROLE; an admin/owner connection is not valid here.
DATABASE_URL=
DNA_DATABASE_OWNER_ID=
DNA_DATABASE_RUNTIME_ROLE=dna_app_runtime

# Private Cloudflare R2 and provider-readiness access. Keep the bucket private,
# keep r2.dev and custom public domains disabled, and scope credentials minimally.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DNA_R2_BUCKET_NAME=
DNA_R2_ACCESS_KEY_ID=
DNA_R2_SECRET_ACCESS_KEY=

# Durable import queue identity used for bounded Preview dispatch/capacity checks.
# Queue/consumer/DLQ commissioning remains mandatory before enabling upload.
DNA_IMPORT_QUEUE_ID=
DNA_IMPORT_QUEUE_NAME=
DNA_IMPORT_DEAD_LETTER_QUEUE_NAME=

# Explicit stop-before-limit controls. Leave any value blank until the current
# provider allowance is verified and approved; incomplete configuration fails closed.
DNA_IMPORT_LIMIT_R2_STORAGE_BYTES=
DNA_IMPORT_LIMIT_R2_CLASS_A_OPERATIONS=
DNA_IMPORT_LIMIT_R2_CLASS_B_OPERATIONS=
DNA_IMPORT_LIMIT_NEON_STORAGE_BYTES=
DNA_IMPORT_LIMIT_QUEUE_BACKLOG_MESSAGES=
DNA_IMPORT_MINIMUM_HEADROOM_BASIS_POINTS=
DNA_IMPORT_MAXIMUM_MEASUREMENT_AGE_MILLISECONDS=
