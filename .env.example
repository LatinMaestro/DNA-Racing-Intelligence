# Preview access switch. Enable only for an intentionally protected Preview.
ENABLE_PHASE0_REVIEW=false

# Explicit Production access switch. Automatic Git deployments remain disabled
# by vercel.json, so routine Git pushes do not deploy this application.
ALLOW_PRODUCTION_DEPLOYMENT=false

# Hosted provider placeholders only. Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AUTHORIZED_CLERK_USER_ID=
DATABASE_URL=
DNA_DATABASE_OWNER_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
